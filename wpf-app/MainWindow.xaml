<Window x:Class="wpf_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_app"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Start Thread" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Click="ButtonStartThreadClick"/>
        <Button Content="Stop Thread" HorizontalAlignment="Left" Margin="83,10,0,0" VerticalAlignment="Top" Click="ButtonStopThreadClick"/>
        <Button Content="Get Counter" HorizontalAlignment="Left" Margin="156,10,0,0" VerticalAlignment="Top" Click="ButtonGetCounterClick"/>
        <Label Name="LabelCounter"  Content="" HorizontalAlignment="Left" Margin="10,35,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
