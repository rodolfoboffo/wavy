<UserControl x:Class="Wavy.UI.PortPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wavy.UI"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="InputPortColumn"/>
            <ColumnDefinition SharedSizeGroup="PortNameColumn"/>
            <ColumnDefinition SharedSizeGroup="PortValueControlColumn"/>
            <ColumnDefinition SharedSizeGroup="OutputPortColumn"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Rectangle Name="InputPortHandleRect"
                   Style="{StaticResource PortHandleRectangle}" 
                   Grid.Column="0" 
                   Visibility="{Binding InputPortHandleVisibility}" />
        <Label Style="{StaticResource PortName}" 
               Content="{Binding PortName}" 
               Grid.Column="1"/>
        <TextBox Style="{StaticResource PortValueTextBox}" 
                 Name="PortValueTextBox" 
                 Grid.Column="2" 
                 Visibility="{Binding ValueTextBoxVisibility}" 
                 MouseLeftButtonDown="PortValueTextBox_MouseLeftButtonDown"
                 MouseMove="PortValueTextBox_MouseMove"/>
        <Rectangle Name="OutputPortHandleRect"
                   Style="{StaticResource PortHandleRectangle}" 
                   Grid.Column="3" 
                   Visibility="{Binding OutputPortHandleVisibility}" />
    </Grid>
</UserControl>
