<UserControl x:Class="Wavy.UI.PipePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wavy.UI"
             mc:Ignorable="d"
             MouseMove="PipePanel_MouseMove"
             MouseLeftButtonDown="PipePanel_MouseLeftButtonDown"
             Canvas.Top="{Binding PosY, Mode=TwoWay}"
             Canvas.Left="{Binding PosX, Mode=TwoWay}">
    <Border Style="{StaticResource PipeBorder}">
        <Grid>
            <Label Style="{StaticResource PipeTitle}" Name="LabelPipeName" Content="{Binding Name}"/>
        </Grid>
    </Border>
</UserControl>
