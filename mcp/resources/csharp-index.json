  "commonPatterns": [
    {
      "name": "Creating and Using a Pipe",
      "example": [
        "var pipe = AppController.Instance.CreatePipe(\"ConstantWavePipe\");",
        "pipe.Init();",
        "pipe.SetRunning(true);",
        "var outputPort = pipe.GetOutputPort(0);"
      ]
    },
    {
      "name": "Connecting Two Pipes",
      "example": [
        "var outputPort = pipe1.GetOutputPort(0);",
        "var inputPort = pipe2.GetInputPort(0);",
        "outputPort.SetLinkedPort(inputPort);"
      ]
    },
    {
      "name": "P/Invoke Marshalling Pattern",
      "pattern": "[DllImport(\"wavy.dll\", CallingConvention = CallingConvention.Cdecl)] private static extern <RETURN_TYPE> <FUNCTION_NAME>(<PARAMETERS>);"
    }
  ]
