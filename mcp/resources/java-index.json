  "commonPatterns": [
    {
      "name": "Adding a New Pipe Type",
      "steps": [
        "1. Create class extending Pipe in pipes/{category}/",
        "2. Implement getInputPortCount() and getOutputPortCount()",
        "3. Override process() method for signal handling",
        "4. Register in PipeFactory",
        "5. Create UI representation (extends AbstractPipeRepr)",
        "6. Add marshalling support in PipeMarshaller"
      ]
    },
    {
      "name": "Connecting Pipes Programmatically",
      "example": "project.connectPorts(pipe1.getOutputPort(0), pipe2.getInputPort(0));"
    }
  ]
