          "inputs": 3,
          "outputs": 1,
          "parameters": {
            "inputCount": {"type": "int", "default": 3, "min": 2, "max": 8, "description": "Number of inputs to combine"}
          }
        },
        {
          "name": "MultiplicationPipe",
          "class": "com.terpomo.wavy.pipes.operators.MultiplicationPipe",
