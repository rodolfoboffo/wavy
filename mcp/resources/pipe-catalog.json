        },
        {
          "name": "FFTPipe",
          "class": "com.terpomo.wavy.pipes.monitors.FFTPipe",
          "description": "Frequency spectrum analysis via FFT",
          "inputs": 1,
          "outputs": 0,
          "parameters": {
            "fftSize": {"type": "int", "default": 4096, "min": 256, "max": 65536, "unit": "samples", "constraint": "Must be power of 2"},
            "windowType": {"type": "enum", "options": ["RECTANGULAR", "HANN", "HAMMING", "BLACKMAN"], "default": "HANN"},
            "overlap": {"type": "float", "default": 0.5, "min": 0.0, "max": 0.9, "description": "Frame overlap ratio"},
            "dBScale": {"type": "boolean", "default": true, "description": "Display in dB or linear"}
          }
        }
      ]
