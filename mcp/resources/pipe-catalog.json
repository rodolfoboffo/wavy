          }
        },
        {
          "name": "IQModulationPipe",
          "class": "com.terpomo.wavy.pipes.operators.IQModulationPipe",
          "description": "In-phase/Quadrature modulation (complex modulation)",
          "inputs": 2,
          "outputs": 1,
          "inputLabels": ["inPhase", "quadrature"],
          "parameters": {
            "carrierFrequency": {"type": "double", "default": 10000.0, "min": 0.1, "max": 100000.0, "unit": "Hz"}
          }
        },
        {
          "name": "IQDemodulationPipe",
          "class": "com.terpomo.wavy.pipes.operators.IQDemodulationPipe",
          "description": "In-phase/Quadrature demodulation (complex demod)",
          "inputs": 1,
          "outputs": 2,
          "outputLabels": ["inPhase", "quadrature"],
          "parameters": {
            "carrierFrequency": {"type": "double", "default": 10000.0, "min": 0.1, "max": 100000.0, "unit": "Hz"}
          }
        }
      ]
    },
    "monitors": {
      "count": 2,
