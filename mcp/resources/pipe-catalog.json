    "sources": {
      "count": 5,
      "category": "Signal generation",
      "pipes": [
        {
          "name": "ConstantWavePipe",
          "class": "com.terpomo.wavy.pipes.sources.ConstantWavePipe",
          "description": "Generate sinusoidal waveform",
          "inputs": 0,
          "outputs": 1,
          "parameters": {
            "frequency": {"type": "double", "default": 1000.0, "min": 0.1, "max": 100000.0, "unit": "Hz"},
            "amplitude": {"type": "float", "default": 1.0, "min": 0.0, "max": 10.0, "unit": "linear"},
            "phase": {"type": "float", "default": 0.0, "min": 0.0, "max": 6.283185, "unit": "radians"},
            "sampleRate": {"type": "int", "default": 44100, "min": 8000, "max": 192000, "unit": "Hz"}
          }
        },
        {
          "name": "NoisePipe",
          "class": "com.terpomo.wavy.pipes.sources.NoisePipe",
          "description": "Generate random noise signal",
          "inputs": 0,
          "outputs": 1,
          "parameters": {
            "noiseType": {"type": "enum", "options": ["WHITE", "PINK", "BROWN"], "default": "WHITE"},
            "amplitude": {"type": "float", "default": 1.0, "min": 0.0, "max": 10.0, "unit": "linear"}
          }
        },
        {
          "name": "FileReaderPipe",
          "class": "com.terpomo.wavy.pipes.sources.FileReaderPipe",
          "description": "Read audio from WAV file",
          "inputs": 0,
          "outputs": 1,
          "parameters": {
            "filePath": {"type": "string", "default": "", "description": "Path to audio file"},
            "loopAudio": {"type": "boolean", "default": false, "description": "Loop playback at end"}
          }
        },
        {
          "name": "MicPipe",
          "class": "com.terpomo.wavy.pipes.sources.MicPipe",
          "description": "Capture microphone input",
          "inputs": 0,
          "outputs": 1,
          "parameters": {
            "sampleRate": {"type": "int", "default": 44100, "min": 8000, "max": 192000, "unit": "Hz"},
            "bufferSize": {"type": "int", "default": 2048, "min": 256, "max": 8192, "unit": "samples"},
            "deviceIndex": {"type": "int", "default": 0, "description": "Audio device index"}
          }
        },
        {
          "name": "RTLPipe",
          "class": "com.terpomo.wavy.pipes.sources.RTLPipe",
          "description": "RTL-SDR software-defined radio receiver",
          "inputs": 0,
          "outputs": 1,
          "parameters": {
            "frequency": {"type": "long", "default": 100000000, "min": 30000000, "max": 2000000000, "unit": "Hz"},
            "sampleRate": {"type": "int", "default": 2400000, "min": 1000000, "max": 3200000, "unit": "Hz"},
            "gain": {"type": "float", "default": 35.0, "min": 0.0, "max": 50.0, "unit": "dB"},
            "deviceIndex": {"type": "int", "default": 0, "description": "RTL-SDR device index"}
          }
        }
      ]
    },
    "filters": {
      "count": 1,
      "category": "Signal filtering and processing",
      "pipes": [
        {
          "name": "BandPassFilterPipe",
          "class": "com.terpomo.wavy.pipes.filters.BandPassFilterPipe",
          "description": "Pass frequencies within specified band",
          "inputs": 1,
          "outputs": 1,
          "parameters": {
            "lowFrequency": {"type": "double", "default": 500.0, "min": 0.1, "max": 50000.0, "unit": "Hz"},
            "highFrequency": {"type": "double", "default": 5000.0, "min": 0.1, "max": 50000.0, "unit": "Hz"},
            "filterOrder": {"type": "int", "default": 4, "min": 1, "max": 10, "description": "Butterworth order"},
            "filterType": {"type": "enum", "options": ["BUTTERWORTH", "CHEBYSHEV"], "default": "BUTTERWORTH"}
          },
          "constraints": "lowFrequency must be < highFrequency"
        }
      ]
    },
