      "pipes": [
        {
          "name": "OscilloscopePipe",
          "class": "com.terpomo.wavy.pipes.monitors.OscilloscopePipe",
          "description": "Real-time waveform visualization (no output)",
          "inputs": 1,
          "outputs": 0,
          "parameters": {
            "bufferSize": {"type": "int", "default": 4096, "min": 1024, "max": 65536, "unit": "samples", "description": "Waveform display length"},
